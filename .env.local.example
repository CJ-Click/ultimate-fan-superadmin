# Supabase (server + client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Session cookie signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# Superadmin login is verified against password hashes in the `users` table.
# Create and manage those accounts from the console; do not add a shared
# environment password fallback.
